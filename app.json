{
  "expo": {
    "name": "WUK AI",
    "slug": "wuk-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.wuk72.wukai",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#A8D3F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "WUK AI uses the microphone only when you tap voice input.",
          "speechRecognitionPermission": "WUK AI converts your speech to editable text for your message.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WUK AI accesses a photo only when you choose to ask about it.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "84fed9da-4c8a-4336-98d8-7e3fce32c757"
      }
    }
  }
}
