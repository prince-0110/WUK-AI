# Keep this file's real copy (backend/.env) private and never commit it.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional server-managed chat providers. These are API keys, not consumer
# account passwords or subscriptions. Each provider may charge separately.
# Configure keys only in the private backend host environment (for example Render).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional API providers. Keys stay in this backend environment, never in Expo.
# Auto selects a provider by capability and retries another compatible provider
# on quota/rate-limit/service errors. Provider charges and free-tier limits vary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_VISION_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_IMAGE_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VISION_MODEL=ministral-14b-latest
OPENAI_IMAGE_MODEL=gpt-image-1

# For an Android emulator, 127.0.0.1 is enough.
# For a physical phone on the same trusted Wi-Fi, set HOST=0.0.0.0 and allow
# the port only on Windows Private networks. Do not port-forward it publicly.
HOST=127.0.0.1
PORT=8787

# Use a private passphrase of at least 12 characters. Avoid short PINs.
API_ACCESS_PASSWORD=replace-with-a-private-passphrase-at-least-12-characters

# Comma-separated exact origins allowed to call this backend from a browser.
# Set this to your deployed WUK AI website origin in production; never use '*'.
WEB_ORIGINS=https://your-wuk-ai-site.example
