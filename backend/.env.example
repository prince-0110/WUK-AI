# Keep this file's real copy (backend/.env) private and never commit it.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# For an Android emulator, 127.0.0.1 is enough.
# For a physical phone on the same trusted Wi-Fi, set HOST=0.0.0.0 and allow
# the port only on Windows Private networks. Do not port-forward it publicly.
HOST=127.0.0.1
PORT=8787

# Set a random value with at least 32 characters. Generate in PowerShell:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_ACCESS_TOKEN=replace-with-a-random-64-character-hex-token
